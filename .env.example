# Copy this file to .env and adjust it (./install.sh creates .env for you).
# Copie este arquivo para .env e ajuste (o ./install.sh cria o .env para você).

# Library folder (must exist). / Pasta da biblioteca (precisa existir).
MDOP_LIBRARY=/mnt/hd1/mdop-library

# Folder with the files you want to import (spaces and accents are fine).
# Pasta com os arquivos para importar (pode ter espaços e acentos).
MDOP_IMPORT=/mnt/hd1/recordings

# Root folder of your sound effects, read-only (optional; leave empty if unused).
# Pasta raiz dos efeitos sonoros, só leitura (opcional; deixe vazio se não usa).
MDOP_SFX=/mnt/hd2/sound-effects

# Backup folder (ideally another drive). / Pasta dos backups (de preferência outro HD).
MDOP_BACKUPS=/mnt/hd2/mdop-backups

# Browser port / Porta no navegador: http://SERVER-IP:8090
MDOP_PORT=8090

# User and group that own the files (find them with: id)
# Usuário e grupo donos dos arquivos (descubra com: id)
PUID=1000
PGID=1000

# Largest file accepted per upload, in MB (0 = no limit).
# Maior arquivo aceito por envio, em MB (0 = sem limite).
MDOP_MAX_UPLOAD_MB=2048
